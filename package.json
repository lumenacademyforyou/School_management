{
  "name": "lumenacademy-sms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:admin": "vite --port=3000 --host=0.0.0.0",
    "dev:parent": "vite --mode parent --port=3001 --host=0.0.0.0",
    "dev:teacher": "vite --mode teacher --port=3002 --host=0.0.0.0",
    "dev:apps": "vite --mode apps --port=3003 --host=0.0.0.0",
    "dev:demo": "vite --mode demo --port=3004 --host=0.0.0.0",
    "build": "vite build && vite build --mode parent && vite build --mode teacher",
    "build:admin": "vite build",
    "build:parent": "vite build --mode parent",
    "build:teacher": "vite build --mode teacher",
    "preview": "vite preview",
    "preview:parent": "vite preview --mode parent",
    "preview:teacher": "vite preview --mode teacher",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
