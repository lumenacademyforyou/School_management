{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:parent": "vite --mode parent --port=3001 --host=0.0.0.0",
    "dev:teacher": "vite --mode teacher --port=3002 --host=0.0.0.0",
    "dev:apps": "vite --mode apps --port=3003 --host=0.0.0.0",
    "build": "vite build && vite build --mode parent && vite build --mode teacher",
    "build:admin": "vite build",
    "build:parent": "vite build --mode parent",
    "build:teacher": "vite build --mode teacher",
    "preview": "vite preview",
    "preview:parent": "vite preview --mode parent",
    "preview:teacher": "vite preview --mode teacher",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "@types/express": "^4.17.21",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4"
  }
}
