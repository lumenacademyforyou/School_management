# Postgres connection used by the app and by the integration tests.
DATABASE_URL=postgres://postgres@localhost:5432/lumen_platform

# Signing key for access/refresh tokens. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-value-at-least-32-chars

# Token lifetimes (seconds).
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

PORT=3000
NODE_ENV=development
