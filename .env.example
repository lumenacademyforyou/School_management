# Postgres connection used by the app.
#
# This MUST be the unprivileged lumen_app role, never an admin/superuser:
# superusers bypass row level security and the tenant boundary disappears.
# The server refuses to start otherwise. See docs/environments.md.
#
# Local:
DATABASE_URL=postgres://lumen_app:choose-one@localhost:5432/lumen_platform
# Supabase (shared pooler), for reference. Note two things:
#  - through the pooler the username is <role>.<project-ref>
#  - uselibpqcompat=true&sslmode=require encrypts without verifying the chain;
#    plain sslmode=require fails with SELF_SIGNED_CERT_IN_CHAIN. In production
#    use sslmode=verify-full&sslrootcert=<Supabase CA> instead.
# DATABASE_URL=postgresql://lumen_app.<project-ref>:[LUMEN-APP-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require

# Password for the lumen_app role. `npm run migrate` applies it, so psql is not
# needed. Keep it identical to the password in DATABASE_URL above.
LUMEN_APP_PASSWORD=choose-one

# Admin connection, used only by `npm run migrate` and `npm run seed`.
# ADMIN_DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Signing key for access/refresh tokens. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-value-at-least-32-chars

# Token lifetimes (seconds).
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# 3000-3004 are taken by the web dev servers (admin 3000, parent 3001,
# teacher 3002, apps 3003, demo 3004), so the API listens on 4000.
PORT=4000
NODE_ENV=development

# ─── Web apps (web/ workspace) ───────────────────────────────────────────────
# Where the separately deployed parent and teacher apps live.
# The staff sign-in page and the feature catalogue link to these.
VITE_PARENT_APP_URL="http://localhost:3001/"
VITE_TEACHER_APP_URL="http://localhost:3002/"

# Base URL the web apps call the API on.
VITE_API_BASE_URL="http://localhost:4000"
