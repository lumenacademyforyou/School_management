# Seeing the API work, without leaving VS Code.
#
# Install the "REST Client" extension (humao.rest-client), then click the
# "Send Request" link that appears above each ### block below.
#
# Run `npm run dev` first. Log in before the requests that need a token —
# REST Client reuses the login response, so the Authorization headers below
# fill themselves in.

@host = http://localhost:3000

###
# Is the server up? This one also works in a browser.
GET {{host}}/health

###
# @name login
# A teacher at the seeded demo school.
POST {{host}}/auth/login
Content-Type: application/json

{
  "tenantSlug": "demo-school",
  "email": "teacher@demo-school.test",
  "password": "demo-password-123"
}

###
# Who am I, and what am I allowed to do?
# Note `permissions` — resolved from the role matrix on every request,
# never carried in the token.
GET {{host}}/auth/me
Authorization: Bearer {{login.response.body.accessToken}}

###
# This school's students, with each one's current class and section.
GET {{host}}/students
Authorization: Bearer {{login.response.body.accessToken}}

###
# A teacher may READ students but not create them: expect 403 with
# "This action requires the student:manage permission".
POST {{host}}/students
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "admissionNo": "REJECTED-1",
  "fullName": "Should Be Rejected"
}

###
# @name adminLogin
# The same school's admin, who does have student:manage.
POST {{host}}/auth/login
Content-Type: application/json

{
  "tenantSlug": "demo-school",
  "email": "admin@demo-school.test",
  "password": "demo-password-123"
}

###
# School setup (LS-28). Where is the setup wizard up to? After `npm run seed`
# every required step is done.
GET {{host}}/setup/status
Authorization: Bearer {{adminLogin.response.body.accessToken}}

###
GET {{host}}/academic-years
Authorization: Bearer {{adminLogin.response.body.accessToken}}

###
GET {{host}}/classes
Authorization: Bearer {{adminLogin.response.body.accessToken}}

###
# @name sections
# Sections for the current academic year unless ?academicYearId= says otherwise.
GET {{host}}/sections
Authorization: Bearer {{adminLogin.response.body.accessToken}}

###
# Overlaps the seeded 2026-27 year: expect 409 conflict.
POST {{host}}/academic-years
Authorization: Bearer {{adminLogin.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Overlapping",
  "startsOn": "2027-01-01",
  "endsOn": "2027-12-31"
}

###
# Every listed class gets every listed section name, in one transaction.
# Swap in real class ids from GET /classes. Re-running it gives 409, and
# creates nothing.
POST {{host}}/sections/bulk
Authorization: Bearer {{adminLogin.response.body.accessToken}}
Content-Type: application/json

{
  "academicYearId": "{{sections.response.body.academicYearId}}",
  "classIds": ["<class id>"],
  "names": ["C"],
  "capacity": 40
}

###
# Admit a student straight into the first listed section.
# Expect 201 with currentEnrollment filled in.
POST {{host}}/students
Authorization: Bearer {{adminLogin.response.body.accessToken}}
Content-Type: application/json

{
  "admissionNo": "ADM-2026-100",
  "fullName": "Rohan Mehta",
  "gender": "male",
  "sectionId": "{{sections.response.body.sections[0].id}}"
}

###
# Now the list has him in it.
GET {{host}}/students
Authorization: Bearer {{adminLogin.response.body.accessToken}}

###
# A parent sees a narrower permission set: student:read_own, result:read and
# fee:read, but no student:manage.
# @name parentLogin
POST {{host}}/auth/login
Content-Type: application/json

{
  "tenantSlug": "demo-school",
  "email": "parent@demo-school.test",
  "password": "demo-password-123"
}

###
GET {{host}}/auth/me
Authorization: Bearer {{parentLogin.response.body.accessToken}}

###
# The same list the admin saw, narrowed to this parent's own child.
GET {{host}}/students
Authorization: Bearer {{parentLogin.response.body.accessToken}}

###
# And no school configuration at all: expect 403.
GET {{host}}/classes
Authorization: Bearer {{parentLogin.response.body.accessToken}}

###
# Wrong password: 401, and the body is identical to what an unknown
# email or an unknown school returns. That is deliberate — the endpoint
# will not tell you which accounts exist.
POST {{host}}/auth/login
Content-Type: application/json

{
  "tenantSlug": "demo-school",
  "email": "teacher@demo-school.test",
  "password": "definitely-the-wrong-password"
}
