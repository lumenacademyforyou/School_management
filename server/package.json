{
  "name": "@lumen/platform-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Shared multi-tenant platform base: auth, RBAC and tenant isolation for School MMS, QPG and Assessment.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts"
}
